# Base de dados local (docker compose up -d postgres). Porta 5436: nao colide com as aulas 06 (5434) e 07 (5435).
DATABASE_URL=postgresql://dq:dq@localhost:5436/dq

# Cenario simulado: healthy | broken
SCENARIO=healthy
# Vazio = os 3 providers. Ex.: PROVIDERS=trafficjunky,voluum
PROVIDERS=

# "Hoje" da simulacao (ultimo dia de dados esperado). Fixo para a demo ser reprodutivel.
AS_OF_DATE=2026-11-13

# strict  = um FAIL numa gate PARA o pipeline (como no Airflow)
# observe = um FAIL bloqueia o publish mas as camadas seguintes continuam a ser verificadas (modo de aula)
GATE_MODE=observe

# Webhook opcional para alertas. Vazio = nao chama a internet (so consola + tabela data_quality.alerts).
DQ_WEBHOOK_URL=
