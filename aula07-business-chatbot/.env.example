# --- Base de dados (docker compose: porta 5435) ---
# Agente SQL: role read-only, so ve analytics.campaign_performance_daily
DATABASE_URL=postgresql://analytics_agent:agent_dev@localhost:5435/analytics
# Retriever RAG: role read-only, so ve o schema knowledge
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge_reader:reader_dev@localhost:5435/analytics
# Indexacao (python -m rag.index): dono dos schemas. So dev local.
INDEX_DATABASE_URL=postgresql+psycopg://analytics:analytics@localhost:5435/analytics

# --- Modelo de conversa: bedrock | ollama ---
LLM_PROVIDER=ollama
AWS_REGION=eu-north-1
# Credenciais Bedrock: credential chain da AWS ou a variavel AWS_BEARER_TOKEN_BEDROCK exportada no terminal.
# NUNCA colocar chaves neste ficheiro nem no repositorio.
BEDROCK_MODEL_ID=
# Modelos mostrados na UI (so os preenchidos aparecem). Usa ids que existam na tua conta/regiao.
BEDROCK_NOVA2_LITE_MODEL_ID=
BEDROCK_NOVA_LITE_MODEL_ID=
BEDROCK_CLAUDE_HAIKU_MODEL_ID=
BEDROCK_GPT_TERRA_MODEL_ID=
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# Fallback se a descoberta automatica (GET /api/tags) falhar. Separados por virgula.
OLLAMA_MODELS=

# --- RAG ---
EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_COLLECTION=internal_knowledge
KNOWLEDGE_K=4
# Distancia coseno maxima (menor = mais parecido). Chunks acima sao descartados.
# 0.40 foi calibrado para nomic-embed-text + estes documentos: recalibrar se mudares de modelo/corpus.
KNOWLEDGE_MAX_DISTANCE=0.40

# --- Limites e custo (opcional) ---
MAX_MODEL_CALLS=6
MAX_TOOL_CALLS=8
MAX_COST_PER_REQUEST=
MODEL_INPUT_PRICE_PER_1M=
MODEL_OUTPUT_PRICE_PER_1M=

# "Hoje" para o agente. Os dados seed vao de 2026-10-26 a 2026-11-08, logo ontem = 2026-11-08.
AS_OF_DATE=2026-11-09
