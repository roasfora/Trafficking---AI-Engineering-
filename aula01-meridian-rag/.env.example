# Copia para .env e ajusta se precisares.   cp .env.example .env
#
# Repara no que NÃO está aqui: nenhuma API key.
# Nada nesta aplicação sai da tua máquina.

# --- modelos ---------------------------------------------------------------
# Com 8 GB de RAM ou menos, usa llama3.2:3b
MERIDIAN_CHAT_MODEL=llama3.1:8b
MERIDIAN_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# 0.0 determinístico | 0.2 trabalho sobre documentos | 0.8+ brainstorm
MERIDIAN_TEMPERATURE=0.2

# --- indexação -------------------------------------------------------------
# Tamanho de cada pedaço, em caracteres. Se mudares, reconstrói o índice.
MERIDIAN_CHUNK_SIZE=900
MERIDIAN_CHUNK_OVERLAP=150

# Quantos pedaços entregamos ao modelo por pergunta
MERIDIAN_TOP_K=4

# --- conversa --------------------------------------------------------------
# Quantas mensagens do histórico reenviamos a cada pergunta
MERIDIAN_MAX_HISTORY=10
