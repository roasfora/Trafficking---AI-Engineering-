# Copia para .env e ajusta se precisares.   cp .env.example .env
#
# Nunca ponhas credenciais reais em codigo, nem neste ficheiro de exemplo.
# O .env esta no .gitignore. Os tokens abaixo sao PLACEHOLDERS.

# --- Mock ou API real? -------------------------------------------------------
# true  -> a pipeline fala com a mock API local (FastAPI), determinística.
# false -> usa as URLs e tokens dos providers, mais abaixo.
# ATENCAO: false NAO foi validado contra as APIs reais. Os mocks sao
# representacoes pedagogicas inferidas; ver README, secao "Limitacoes".
USE_MOCK_API=true
MOCK_API_BASE_URL=http://mock-api:8000
# Mesma seed => exatamente os mesmos dados.
MOCK_SEED=42
# Quanto tempo o modo "timeout" demora a responder (segundos).
MOCK_TIMEOUT_DELAY_SECONDS=20

# --- Base de dados ANALYTICS (destino do ETL) ------------------------------
# E aqui que vivem dim_campaign e fact_campaign_daily. Para apontar para outro
# PostgreSQL (ex.: Render), e SO esta variavel que muda.
DATABASE_URL=postgresql://providers:providers@postgres:5432/analytics

# --- Servidor PostgreSQL local (docker compose) ----------------------------
# Um so servidor, DUAS bases de dados:
#   "analytics" -> dados do negocio (DATABASE_URL acima)
#   "airflow"   -> metadados do Airflow (runs, task instances, XComs...)
POSTGRES_USER=providers
POSTGRES_PASSWORD=providers
POSTGRES_DB=analytics
# Portas do HOST. Diferentes das da aula 02 (5432/8000/8080) para poderes ter
# as duas aulas ligadas ao mesmo tempo. Dentro do Docker as portas nao mudam.
POSTGRES_HOST_PORT=5433
MOCK_API_HOST_PORT=8001
AIRFLOW_HOST_PORT=8081

# --- Base de dados de METADADOS do Airflow ---------------------------------
# NAO e a base analytics. O Airflow usa-a para se lembrar do que correu.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://providers:providers@postgres:5432/airflow

# --- TrafficJunky (so usado com USE_MOCK_API=false) ------------------------
TRAFFICJUNKY_BASE_URL=https://CHANGE-ME.example.com
TRAFFICJUNKY_BEARER_TOKEN=CHANGE_ME
TRAFFICJUNKY_STATS_PATH=/campaigns/stats.json
# Vazio = sem health check dedicado (o check_api limita-se a registar isso).
TRAFFICJUNKY_HEALTH_PATH=
# Como obter o total de CONTROLO do dia:
#   summary_endpoint -> um endpoint de totais independente (o do mock)
#   refetch_stats    -> voltar a pedir as stats e somar (nao independente do detalhe!)
TRAFFICJUNKY_TOTAL_STRATEGY=summary_endpoint
TRAFFICJUNKY_TOTAL_PATH=CHANGE-ME
# Moeda em que o provider fatura. Simplificacao pedagogica: EUR.
TRAFFICJUNKY_CURRENCY=EUR

# --- Erobella (so usado com USE_MOCK_API=false) ----------------------------
EROBELLA_BASE_URL=https://CHANGE-ME.example.com
EROBELLA_API_TOKEN=CHANGE_ME
EROBELLA_STATS_PATH=/api/v1/stats
EROBELLA_HEALTH_PATH=
EROBELLA_CURRENCY=EUR

# --- Pipeline ----------------------------------------------------------------
# Timeout HTTP de cada pedido. Tem de ser MENOR que MOCK_TIMEOUT_DELAY_SECONDS,
# senao o cenario "timeout" nao falha.
PIPELINE_HTTP_TIMEOUT_SECONDS=5
# Pequeno de proposito: com os dados do mock, o TrafficJunky ocupa 2 paginas.
PIPELINE_PAGE_SIZE=5
# Reconciliacao: diferenca maxima aceite entre o total da API e o da base de
# dados (na moeda do provider). Nos tickets reais a tolerancia e 1 unidade.
RECONCILE_TOLERANCE=0.01

# --- Airflow (simplificacoes de formacao) ----------------------------------
# Sem ecra de login. NUNCA em producao.
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
