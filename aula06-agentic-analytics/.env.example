# Copia para .env e ajusta.   cp .env.example .env
# Nunca ponhas credenciais reais neste ficheiro. O .env esta no .gitignore.

# -----------------------------------
# PostgreSQL (docker compose)
# -----------------------------------
# Utilizador READ-ONLY do agente (criado em sql/01_schema.sql).
DATABASE_URL=postgresql://analytics_agent:agent_dev@localhost:5434/analytics

# -----------------------------------
# Model provider (CLI; a UI Streamlit escolhe na sidebar)
# -----------------------------------
# bedrock | ollama
LLM_PROVIDER=bedrock

# -----------------------------------
# Amazon Bedrock
# -----------------------------------
# As credenciais vem da credential chain normal da AWS
# (aws configure, AWS_PROFILE, SSO, role...). NAO ha AWS keys aqui.
AWS_REGION=eu-north-1

# Ids dos modelos (ou inference profiles) ATIVOS na tua conta/regiao.
# Nao ha defaults: so aparecem na UI os que preencheres.
BEDROCK_NOVA2_LITE_MODEL_ID=
BEDROCK_NOVA_LITE_MODEL_ID=
BEDROCK_CLAUDE_HAIKU_MODEL_ID=
BEDROCK_GPT_TERRA_MODEL_ID=
# Modelo usado pela CLI (python app.py ...). Os precos abaixo valem para este.
BEDROCK_MODEL_ID=

# -----------------------------------
# Ollama
# -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Modelo da CLI com LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
# Opcional: so se a descoberta automatica (GET /api/tags) nao funcionar. Ex.: qwen2.5:7b-instruct,llama3.1:8b
OLLAMA_MODELS=

# -----------------------------------
# Custo estimado (opcional)
# -----------------------------------
# USD por 1M tokens, da pagina de precos do BEDROCK_MODEL_ID. Noutros modelos da UI o custo
# fica 'unavailable' (nunca aplicamos o preco de um modelo a outro).
# Vazio => estimated_model_cost = null (nao inventamos precos).
MODEL_INPUT_PRICE_PER_1M=
MODEL_OUTPUT_PRICE_PER_1M=

# --- Limites do agente --------------------------------------------------------
MAX_MODEL_CALLS=6
MAX_TOOL_CALLS=8
# Em USD. So funciona se os precos acima estiverem preenchidos.
MAX_COST_PER_REQUEST=0.50

# --- Demo ---------------------------------------------------------------------
# Os dados vao ate 2026-11-05. Com esta data, "ontem" = 2026-11-05.
# Vazio => usa a data de hoje.
AS_OF_DATE=2026-11-06
