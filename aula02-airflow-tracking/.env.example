# Copia para .env e ajusta se precisares.   cp .env.example .env
#
# Nunca ponhas credenciais reais em codigo, nem neste ficheiro de exemplo.
# O .env esta no .gitignore.

# --- Base de dados ANALYTICS (destino do ETL) ------------------------------
# E aqui que vivem dim_* e fact_*. Para apontar para o PostgreSQL do Render,
# e SO esta variavel que muda (o Render da-te o URL; usa o "External" se
# correres fora do Render e acrescenta ?sslmode=require).
#   exemplo Render: postgresql://user:pass@dpg-xxxx.frankfurt-postgres.render.com/dbname?sslmode=require
DATABASE_URL=postgresql://tracking:tracking@postgres:5432/analytics

# --- Servidor PostgreSQL local (docker compose) ----------------------------
# Um so servidor, DUAS bases de dados:
#   "analytics" -> dados do negocio (DATABASE_URL acima)
#   "airflow"   -> metadados do Airflow (runs, task instances, XComs...)
# Em producao seriam servidores diferentes, com utilizadores diferentes.
POSTGRES_USER=tracking
POSTGRES_PASSWORD=tracking
POSTGRES_DB=analytics
POSTGRES_HOST_PORT=5432

# --- Base de dados de METADADOS do Airflow ---------------------------------
# NAO e a base analytics. O Airflow usa-a para se lembrar do que correu.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://tracking:tracking@postgres:5432/airflow

# --- API sintetica (producer) ----------------------------------------------
API_BASE_URL=http://api:8000
# Mesma seed => exatamente os mesmos dados. Muda para "viver" noutro universo.
API_SEED=42
# Quanto tempo o modo "slow" demora a responder (segundos).
API_SLOW_DELAY_SECONDS=20

# --- Pipeline (consumer) ---------------------------------------------------
# Timeout HTTP de cada pedido. Tem de ser MENOR que API_SLOW_DELAY_SECONDS,
# senao o cenario "API lenta" nao falha.
PIPELINE_HTTP_TIMEOUT_SECONDS=5
PIPELINE_PAGE_SIZE=500
# Freshness: o evento mais recente tem de estar a menos de X horas do fim
# da janela processada.
PIPELINE_FRESHNESS_MAX_LAG_HOURS=6

# --- Airflow (simplificacoes de formacao) ----------------------------------
# Sem ecra de login. NUNCA em producao.
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
